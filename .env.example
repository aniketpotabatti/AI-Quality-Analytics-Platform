# Application
APP_ENV=development
APP_NAME=Hallucination Analytics Studio
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Database
# Local dev default: SQLite file (no Postgres install needed).
# For Postgres: postgresql+asyncpg://has:has@localhost:5432/hallucination_analytics
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Redis (job queue)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM providers (optional for local dev)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
